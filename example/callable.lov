import { format } from "std/format.lov";

function add_fn(a: i32, b: i32): i32 -> a + b;

class add_ty {

    public ()(a: i32, b: i32): i32 -> a + b;
}

function callable() {

    let a: i32 = 1;
    let b: i32 = 2;

    let c = add_fn(a, b);

    format("{} + {} = {}\n", a, b, c);

    let i: add_ty;
    let d = i(a, b);

    format("{} + {} = {}\n", a, b, d);
}

type context_ty = { mut v: i32 };

function inc_fn(mut &ctx: context_ty, v: i32) -> ctx.v += v;

class inc_ty {

    public mut ()(v: i32) -> self.v += v;

    public v(): &i32 -> self.v;

    let mut v: i32;
}

function callable_context() {

    let mut ctx: context_ty;
    inc_fn(ctx, 1);
    inc_fn(ctx, 2);
    inc_fn(ctx, 3);

    format("{} + {} + {} = {}\n", 1, 2, 3, ctx.v);

    let mut i: inc_ty;
    i(1);
    i(2);
    i(3);

    format("{} + {} + {} = {}\n", 1, 2, 3, i.v());
}

function callable_lambda() {

    let add = [](a: i32, b: i32): i32 -> a + b;

    format("{} + {} = {}\n", 1, 2, add(1, 2));

    let mut v: i32;
    let inc = [mut &v](x: i32) -> self.v += x;

    inc(1);
    inc(2);
    inc(3);

    format("{} + {} + {} = {}\n", 1, 2, 3, v);
}

interface main(): i32 {
    callable();
    callable_context();
    callable_lambda();

    ret 0;
}

# lambda    => '[' ( '&' | '=' | reference+ )? ']' '(' argument* ')' ( ':' result )? ( '{' statement* '}' | '->' expression )
# reference => 'mut'? '&'? name
# argument  => reference ':' type
# result    => 'mut'? '&'? type
