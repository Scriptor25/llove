interface putchar(c: i32): i32;
interface strlen(s: i8[]): u64;
interface free(block: [mut]);
interface malloc(count: u64): [mut];
interface realloc(block: [mut], count: u64): [mut];
interface memcpy(dst: [mut], src: [], count: u64): [mut];

class string {

    public implicit mut create();
    public implicit mut create(s: i8);
    public implicit mut create(s: i8[]);
    public implicit mut create(mut s: string);
    public implicit mut create(&s: string);

    mut create(beg: i8[mut], end: i8[mut]);

    public mut $(): string;

    public mut delete();

    public empty(): u1;
    public length(): u64;
    public raw(): i8[mut];

    public begin(): i8[];
    public end(): i8[];

    public mut begin(): i8[mut];
    public mut end(): i8[mut];

    public mut clear();

    public mut =(s: i8): mut &string;
    public mut =(s: i8[]): mut &string;
    public mut =(mut s: string): mut &string;
    public mut =(&s: string): mut &string;

    public mut +=(s: i8): mut &string;
    public mut +=(s: i8[]): mut &string;
    public mut +=(s: string): mut &string;
    public mut +=(&s: string): mut &string;

    let mut beg: i8[mut];
    let mut end: i8[mut];
}

function +(&l: string, r: i8): string {
    let mut str: string = l;
    str += r;
    ret str;
}

function +(l: i8, &r: string): string {
    let mut str: string = l;
    str += r;
    ret str;
}

function +(&l: string, r: i8[]): string {
    let mut str: string = l;
    str += r;
    ret str;
}

function +(l: i8[], &r: string): string {
    let mut str: string = l;
    str += r;
    ret str;
}

function +(mut l: string, r: i8): string {
    let mut str: string = $l;
    str += r;
    ret str;
}

function +(l: i8, mut r: string): string {
    let mut str: string = l;
    str += $r;
    ret str;
}

function +(mut l: string, r: i8[]): string {
    let mut str: string = $l;
    str += r;
    ret str;
}

function +(l: i8[], mut r: string): string {
    let mut str: string = l;
    str += $r;
    ret str;
}

function +(&l: string, mut r: string): string {
    let mut str: string = l;
    str += $r;
    ret str;
}

function +(mut l: string, &r: string): string {
    let mut str: string = $l;
    str += r;
    ret str;
}

function +(&l: string, &r: string): string {
    let mut str: string = l;
    str += r;
    ret str;
}

function +(mut l: string, mut r: string): string {
    let mut str: string = $l;
    str += $r;
    ret str;
}

function implicit cast(src: i8[]): string {
    ret create string(src);
}

function print(s: string) {
    foreach (c : s)
        putchar(c);
}

function print(&s: string) {
    foreach (&c : s)
        putchar(c);
}

function hello(&name: string) {
    print("Hello, " + name + "!\n");
}

function hello(name: string) {
    print("Hello, " + name + "!\n");
}

function test(a: u1, b: u1): string {
    let mut x: string = "<empty>\n";
    let s: string = "Hello there!\n";
    let mut m: string = "ABC, 123.\n";

    if (a) {
        x = $m;
    }

    if (b) {
        ret s;
    }

    x = s;
    ret x;
}

interface main(count: i32, args: i8[][]): i32 {
    foreach (str : args..(args + count)) {
        hello(str);
    }

    hello("world");

    test(0, 0);
    test(0, 1);
    test(1, 0);
    test(1, 1);

    ret 0;
}

function:string mut create() {
    self.beg = null;
    self.end = null;
}

function:string mut create(s: i8) {
    self.beg = malloc(1);
    self.end = self.beg + 1;

    *self.beg = s;
}

function:string mut create(s: i8[]) {
    let len = strlen(s);

    self.beg = malloc(len);
    self.end = self.beg + len;

    memcpy(self.beg, s, len);
}

function:string mut create(mut s: string) {
    self.beg = s.beg;
    self.end = s.end;

    s.beg = null;
    s.end = null;
}

function:string mut create(&s: string) {
    let len = s.length();

    self.beg = malloc(len);
    self.end = self.beg + len;

    memcpy(self.beg, s.beg, len);
}

function:string mut create(beg: i8[mut], end: i8[mut]) {
    self.beg = beg;
    self.end = end;
}

function:string mut $(): string {
    let result: string(self.beg, self.end);

    self.beg = null;
    self.end = null;

    ret result;
}

function:string mut delete() {
    if (self.beg) {
        free(self.beg);
    }

    self.beg = null;
    self.end = null;
}

function:string empty(): u1 {
    ret self.beg == self.end;
}

function:string length(): u64 {
    ret self.end - self.beg;
}

function:string raw(): i8[mut] {
    let len = self.length();
    let buffer: i8[mut] = malloc(len + 1);

    memcpy(buffer, self.beg, len);
    buffer[len] = 0;

    ret buffer;
}

function:string begin(): i8[] {
    ret self.beg;
}

function:string end(): i8[] {
    ret self.end;
}

function:string mut begin(): i8[mut] {
    ret self.beg;
}

function:string mut end(): i8[mut] {
    ret self.end;
}

function:string mut clear() {
    if (self.beg) {
        free(self.beg);
    }

    self.beg = null;
    self.end = null;
}

function:string mut =(s: i8): mut &string {
    self.beg = realloc(self.beg, 1);
    self.end = self.beg + 1;

    *self.beg = s;

    ret self;
}

function:string mut =(s: i8[]): mut &string {
    let len = strlen(s);

    self.beg = realloc(self.beg, len);
    self.end = self.beg + len;

    memcpy(self.beg, s, len);

    ret self;
}

function:string mut =(mut s: string): mut &string {
    let beg = self.beg;
    let end = self.end;

    self.beg = s.beg;
    self.end = s.end;

    s.beg = beg;
    s.end = end;

    ret self;
}

function:string mut =(&s: string): mut &string {
    let len = s.length();

    self.beg = realloc(self.beg, len);
    self.end = self.beg + len;

    memcpy(self.beg, s.beg, len);

    ret self;
}

function:string mut +=(s: i8): mut &string {
    let len = self.length();

    self.beg = realloc(self.beg, len + 1);
    self.end = self.beg + len + 1;

    *(self.beg + len) = s;

    ret self;
}

function:string mut +=(s: i8[]): mut &string {
    let len = self.length();
    let slen = strlen(s);

    self.beg = realloc(self.beg, len + slen);
    self.end = self.beg + len + slen;

    memcpy(self.beg + len, s, slen);

    ret self;
}

function:string mut +=(s: string): mut &string {
    let len = self.length();
    let slen = s.length();

    self.beg = realloc(self.beg, len + slen);
    self.end = self.beg + len + slen;

    memcpy(self.beg + len, s.beg, slen);

    ret self;
}

function:string mut +=(&s: string): mut &string {
    let len = self.length();
    let slen = s.length();

    self.beg = realloc(self.beg, len + slen);
    self.end = self.beg + len + slen;

    memcpy(self.beg + len, s.beg, slen);

    ret self;
}
