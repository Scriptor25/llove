interface putchar(c: i32): i32;
interface printf(format: i8[], ...): i32;
interface strlen(s: i8[]): u64;
interface free(block: [mut]);
interface malloc(count: u64): [mut];
interface realloc(block: [mut], count: u64): [mut];
interface memcpy(dst: [mut], src: [], count: u64): [mut];

class string {

    expose implicit mut create();
    expose implicit mut create(s: i8);
    expose implicit mut create(s: i8[]);
    expose implicit mut create(mut s: string);
    expose implicit mut create(&s: string);

    mut create(beg: i8[mut], end: i8[mut]);

    expose mut $(): string;

    expose mut delete();

    expose empty(): u1;
    expose length(): u64;
    expose raw(): i8[mut];

    expose begin(): i8[];
    expose end(): i8[];

    expose mut begin(): i8[mut];
    expose mut end(): i8[mut];

    expose mut clear();

    expose mut =(s: i8): mut &string;
    expose mut =(s: i8[]): mut &string;
    expose mut =(mut s: string): mut &string;
    expose mut =(&s: string): mut &string;

    expose mut +=(s: i8): mut &string;
    expose mut +=(s: i8[]): mut &string;
    expose mut +=(s: string): mut &string;
    expose mut +=(&s: string): mut &string;

    let mut beg: i8[mut];
    let mut end: i8[mut];
}

define +(&l: string, r: i8): string {
    let mut str: string = l;
    str += r;
    yield str;
}

define +(l: i8, &r: string): string {
    let mut str: string = l;
    str += r;
    yield str;
}

define +(&l: string, r: i8[]): string {
    let mut str: string = l;
    str += r;
    yield str;
}

define +(l: i8[], &r: string): string {
    let mut str: string = l;
    str += r;
    yield str;
}

define +(mut l: string, r: i8): string {
    let mut str: string = $l;
    str += r;
    yield str;
}

define +(l: i8, mut r: string): string {
    let mut str: string = l;
    str += $r;
    yield str;
}

define +(mut l: string, r: i8[]): string {
    let mut str: string = $l;
    str += r;
    yield str;
}

define +(l: i8[], mut r: string): string {
    let mut str: string = l;
    str += $r;
    yield str;
}

define +(&l: string, mut r: string): string {
    let mut str: string = l;
    str += $r;
    yield str;
}

define +(mut l: string, &r: string): string {
    let mut str: string = $l;
    str += r;
    yield str;
}

define +(&l: string, &r: string): string {
    let mut str: string = l;
    str += r;
    yield str;
}

define +(mut l: string, mut r: string): string {
    let mut str: string = $l;
    str += $r;
    yield str;
}

define implicit cast(src: i8[]): string {
    yield create string(src);
}

define print(s: string) {
    foreach (c : s)
        putchar(c);
}

define print(&s: string) {
    foreach (&c : s)
        putchar(c);
}

define hello(&name: string) {
    print("Hello, " + name + "!\r\n");
}

define hello(name: string) {
    print("Hello, " + name + "!\r\n");
}

define test(a: u1, b: u1): string {
    let mut x: string = "<empty>\r\n";
    let s: string = "Hello there!\r\n";
    let mut m: string = "ABC, 123.\r\n";

    if (a) {
        x = $m;
    }

    if (b) {
        yield s;
    }

    x = s;
    yield x;
}

interface main(count: i32, args: i8[][]): i32 {
    foreach (str : args..(args + count)) {
        hello(str);
    }

    hello("world");

    test(0, 0);
    test(0, 1);
    test(1, 0);
    test(1, 1);

    yield 0;
}

define:string mut create() {
    self.beg = null;
    self.end = null;
}

define:string mut create(s: i8) {
    self.beg = malloc(1);
    self.end = self.beg + 1;

    *self.beg = s;
}

define:string mut create(s: i8[]) {
    let len = strlen(s);

    self.beg = malloc(len);
    self.end = self.beg + len;

    memcpy(self.beg, s, len);
}

define:string mut create(mut s: string) {
    self.beg = s.beg;
    self.end = s.end;

    s.beg = null;
    s.end = null;
}

define:string mut create(&s: string) {
    let len = s.length();

    self.beg = malloc(len);
    self.end = self.beg + len;

    memcpy(self.beg, s.beg, len);
}

define:string mut create(beg: i8[mut], end: i8[mut]) {
    self.beg = beg;
    self.end = end;
}

define:string mut $(): string {
    let result: string(self.beg, self.end);

    self.beg = null;
    self.end = null;

    yield result;
}

define:string mut delete() {
    if (self.beg) {
        free(self.beg);
    }

    self.beg = null;
    self.end = null;
}

define:string empty(): u1 {
    yield self.beg == self.end;
}

define:string length(): u64 {
    yield self.end - self.beg;
}

define:string raw(): i8[mut] {
    let len = self.length();
    let buffer: i8[mut] = malloc(len + 1);

    memcpy(buffer, self.beg, len);
    buffer[len] = 0;

    yield buffer;
}

define:string begin(): i8[] {
    yield self.beg;
}

define:string end(): i8[] {
    yield self.end;
}

define:string mut begin(): i8[mut] {
    yield self.beg;
}

define:string mut end(): i8[mut] {
    yield self.end;
}

define:string mut clear() {
    if (self.beg) {
        free(self.beg);
    }

    self.beg = null;
    self.end = null;
}

define:string mut =(s: i8): mut &string {
    self.beg = realloc(self.beg, 1);
    self.end = self.beg + 1;

    *self.beg = s;

    yield self;
}

define:string mut =(s: i8[]): mut &string {
    let len = strlen(s);

    self.beg = realloc(self.beg, len);
    self.end = self.beg + len;

    memcpy(self.beg, s, len);

    yield self;
}

define:string mut =(mut s: string): mut &string {
    let beg = self.beg;
    let end = self.end;

    self.beg = s.beg;
    self.end = s.end;

    s.beg = beg;
    s.end = end;

    yield self;
}

define:string mut =(&s: string): mut &string {
    let len = s.length();

    self.beg = realloc(self.beg, len);
    self.end = self.beg + len;

    memcpy(self.beg, s.beg, len);

    yield self;
}

define:string mut +=(s: i8): mut &string {
    let len = self.length();

    self.beg = realloc(self.beg, len + 1);
    self.end = self.beg + len + 1;

    *(self.beg + len) = s;

    yield self;
}

define:string mut +=(s: i8[]): mut &string {
    let len = self.length();
    let slen = strlen(s);

    self.beg = realloc(self.beg, len + slen);
    self.end = self.beg + len + slen;

    memcpy(self.beg + len, s, slen);

    yield self;
}

define:string mut +=(s: string): mut &string {
    let len = self.length();
    let slen = s.length();

    self.beg = realloc(self.beg, len + slen);
    self.end = self.beg + len + slen;

    memcpy(self.beg + len, s.beg, slen);

    yield self;
}

define:string mut +=(&s: string): mut &string {
    let len = self.length();
    let slen = s.length();

    self.beg = realloc(self.beg, len + slen);
    self.end = self.beg + len + slen;

    memcpy(self.beg + len, s.beg, slen);

    yield self;
}
