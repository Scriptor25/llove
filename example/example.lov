interface printf(format: i8[], ...): i32;

define fib(n: i32): i32 {
    let mut a = 0:i32;
    let mut b = 1:i32;
    foreach (_ : <[0:i32,n)>) {
        let c = a + b;
        a = b;
        b = c;
    }
    yield a;
}

define hello(name: i8[]) {
    printf("Hello, %s!\r\n", name);
}

define demangle main(count: i32, args: i8[][]): i32 {
    let n = 10:i32;
    let f = fib(n);
    printf("fib(%d) = %d\r\n", n, f);
    hello("world");
    yield 0;
}

type foo_t = {
    mut bar: i32;
}

define foo(mut bar: i32) {
    bar = bar + 1;
    bar = bar - 1;
    bar += 1;
    bar -= 1;
    bar++;
    bar--;
    ++bar;
    --bar;
}

class string {

    expose create();           # ()[mut &string] => void
    expose create(s: i8);      # (i8)[mut &string] => void
    expose create(s: i8[]);    # (i8[])[mut &string] => void

    expose move(); # (string)[mut &string] => void
    expose copy(); # (&string)[mut &string] => void

    expose delete(); # ()[mut &string] => void

    expose length(): u64; # ()[&string] => u64

    expose mut clear(); # ()[mut &string] => void

    expose mut =(s: i8): mut &string;      # (i8)[mut &string] => mut &string
    expose mut =(s: i8[]): mut &string;    # (i8[])[mut &string] => mut &string
    expose mut =(s: string): mut &string;  # (string)[mut &string] => mut &string
    expose mut =(&s: string): mut &string; # (&string)[mut &string] => mut &string

    expose mut +=(s: i8): mut &string;      # (i8)[mut &string] => mut &string
    expose mut +=(s: i8[]): mut &string;    # (i8[])[mut &string] => mut &string
    expose mut +=(s: string): mut &string;  # (string)[mut &string] => mut &string
    expose mut +=(&s: string): mut &string; # (&string)[mut &string] => mut &string

    expose +(s: i8): string;
    expose +(s: i8[]): string;
    expose +(s: string): string;
    expose +(&s: string): string;

    mut beg: i8[];
    mut end: i8[];
}
