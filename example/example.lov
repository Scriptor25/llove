interface printf(format: i8[], ...): i32;
interface putchar(c: i32): i32;

interface strlen(s: i8[]): u64;

interface free(block: [mut]);
interface malloc(count: u64): [mut];
interface realloc(block: [mut], count: u64): [mut];
interface memcpy(dst: [mut], src: [], count: u64): [mut];

define fib(n: i32): i32 {
    # let mut a = 0;
    # let mut b = 1;
    # foreach (_ : 0..n) {
    #     let c = a + b;
    #     a = b;
    #     b = c;
    # }
    # yield a;
    if (n <= 1)
        yield n;
    yield fib(n - 1) + fib(n - 2);
}

class string {

    expose mut create();
    expose mut create(s: i8);
    expose mut create(s: i8[]);
    expose mut create(mut s: string);
    expose mut create(&s: string);

    expose mut delete();

    expose length(): u64;
    expose raw(): i8[mut];

    expose begin(): i8[];
    expose end(): i8[];

    expose mut begin(): i8[mut];
    expose mut end(): i8[mut];

    expose mut clear();

    expose mut =(s: i8): mut &string;
    expose mut =(s: i8[]): mut &string;
    expose mut =(mut s: string): mut &string;
    expose mut =(&s: string): mut &string;

    expose mut +=(s: i8): mut &string;
    expose mut +=(s: i8[]): mut &string;
    expose mut +=(&s: string): mut &string;

    let mut beg: i8[mut];
    let mut end: i8[mut];
}

define +(&l: string, r: i8): string {
    let mut str: string(l);
    str += r;
    yield str;
}

define +(l: i8, &r: string): string {
    let mut str: string(l);
    str += r;
    yield str;
}

define +(l: i8[], &r: string): string {
    let mut str: string(l);
    str += r;
    yield str;
}

define +(&l: string, &r: string): string {
    let mut str: string(l);
    str += r;
    yield str;
}

define cast(src: i8[]): string {
    let dst: string(src);
    yield dst;
}

define print(&str: string) {
    for (let mut p = str.begin(); p != str.end(); ++p)
        putchar(*p);
}

define hello(&name: string) {
    print("Hello, " + name + "!\r\n");
}

type vec3 = {
    mut x: f64,
    mut y: f64,
    mut z: f64,
}

define +(&l: vec3, &r: vec3): vec3 {
    yield {
        x: l.x + r.x,
        y: l.y + r.y,
        z: l.z + r.z,
    };
}

define -(&l: vec3, &r: vec3): vec3 {
    yield {
        x: l.x - r.x,
        y: l.y - r.y,
        z: l.z - r.z,
    };
}

define foo(mut bar: i32) {
    bar = bar + 1;
    bar = bar - 1;
    bar += 1;
    bar -= 1;
    bar++;
    bar--;
    ++bar;
    --bar;
}

interface main(count: i32, args: i8[][]): i32 {
    # fibonacci example
    let n = 10;
    let f = fib(n);
    printf("fib(%d) = %d\r\n", n, f);

    # dynamic string example
    hello("world");

    # user-defined operator example
    let u: vec3 = { x: 1, y: 2, z: 3 };
    let v: vec3 = { x: 3, y: 2, z: 1 };
    let w = u + v;
    printf("%f %f %f\r\n", u.x, u.y, u.z);
    printf("%f %f %f\r\n", v.x, v.y, v.z);
    printf("%f %f %f\r\n", w.x, w.y, w.z);

    yield 0;
}

define:string mut create() {
    self.beg = null;
    self.end = null;

    printf("string create void");
}

define:string mut create(s: i8) {
    self.beg = malloc(1);
    self.end = self.beg + 1;

    memcpy(self.beg, &s, 1);

    printf("string create i8");
}

define:string mut create(s: i8[]) {
    let len = strlen(s);

    self.beg = malloc(len);
    self.end = self.beg + len;

    memcpy(self.beg, s, len);

    printf("string create i8[]");
}

define:string mut create(mut s: string) {
    self.beg = s.beg;
    self.end = s.end;

    s.beg = null;
    s.end = null;

    printf("string create string");
}

define:string mut create(&s: string) {
    let len = s.length();

    self.beg = malloc(len);
    self.end = self.beg + len;

    memcpy(self.beg, s.beg, len);

    printf("string create &string");
}

define:string mut delete() {
    free(self.beg);

    self.beg = null;
    self.end = null;

    printf("string delete");
}

define:string length(): u64 {
    yield self.end - self.beg;
}

define:string raw(): i8[mut] {
    let len = self.length();
    let buffer: i8[mut] = malloc(len + 1);

    memcpy(buffer, self.beg, len);
    buffer[len] = 0;

    yield buffer;
}

define:string begin(): i8[] {
    yield self.beg;
}

define:string end(): i8[] {
    yield self.end;
}

define:string mut begin(): i8[mut] {
    yield self.beg;
}

define:string mut end(): i8[mut] {
    yield self.end;
}

define:string mut clear() {
    free(self.beg);

    self.beg = null;
    self.end = null;
}

define:string mut =(s: i8): mut &string {
    self.beg = realloc(self.beg, 1);
    self.end = self.beg + 1;

    memcpy(self.beg, &s, 1);

    yield self;
}

define:string mut =(s: i8[]): mut &string {
    let len = strlen(s);

    self.beg = realloc(self.beg, len);
    self.end = self.beg + len;

    memcpy(self.beg, s, len);

    yield self;
}

define:string mut =(mut s: string): mut &string {
    let pbeg = self.beg;
    let pend = self.end;

    self.beg = s.beg;
    self.end = s.end;

    s.beg = pbeg;
    s.end = pend;

    yield self;
}

define:string mut =(&s: string): mut &string {
    let len = s.length();

    self.beg = realloc(self.beg, len);
    self.end = self.beg + len;

    memcpy(self.beg, s.beg, len);

    yield self;
}

define:string mut +=(s: i8): mut &string {
    let len = self.length();

    self.beg = realloc(self.beg, len + 1);
    self.end = self.beg + len + 1;

    memcpy(self.beg + len, &s, 1);

    yield self;
}

define:string mut +=(s: i8[]): mut &string {
    let len = self.length();
    let slen = strlen(s);

    self.beg = realloc(self.beg, len + slen);
    self.end = self.beg + len + slen;

    memcpy(self.beg + len, s, slen);

    yield self;
}

define:string mut +=(&s: string): mut &string {
    let len = self.length();
    let slen = s.length();

    self.beg = realloc(self.beg, len + slen);
    self.end = self.beg + len + slen;

    memcpy(self.beg + len, s.beg, slen);

    yield self;
}
