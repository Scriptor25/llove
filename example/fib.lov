import { format } from "format.lov";

define fib(n: i32): i32 {
    let mut a = 0:i32;
    let mut b = 1:i32;

    foreach (_ : 0:i32..n) {
        let c = a + b;
        a = b;
        b = c;
    }

    yield a;
}

interface main(count: i32, args: i8[][]): i32 {

    let n = 10:i32;
    let f = fib(n);
    format("fib({i32}) = {i32}\r\n", n, f);

    yield 0;
}
