import { format } from "std/format.lov";

define fib(n: i64): i64 {
    if (n <= 1)
        ret 1;

    let mut a = 0:i64;
    let mut b = 1:i64;

    foreach (_ : 0:i64..n) {
        let c = a + b;
        a = b;
        b = c;
    }

    ret a;
}

interface atoi(str: i8[]): i32;

interface main(count: i32, args: i8[][]): i32 {

    if (count != 2)
        ret 1;

    let n = atoi(args[1]);
    let f = fib(n);
    format("fib({}) = {}\n", n, f);

    ret 0;
}
