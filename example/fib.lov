import { format } from "format.lov";

define fib(n: i64): i64 {
    if (n <= 1)
        yield 1;

    let mut a = 0:i64;
    let mut b = 1:i64;

    foreach (_ : 0:i64..n) {
        let c = a + b;
        a = b;
        b = c;
    }

    yield a;
}

interface atoi(str: i8[]): i32;

interface main(count: i32, args: i8[][]): i32 {

    if (count != 2)
        yield 1;

    let n = atoi(args[1]);
    let f = fib(n);
    format("fib({i32}) = {i64}\r\n", n, f);

    yield 0;
}
