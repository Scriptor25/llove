export class stream;

export type string_t = i8[];
export type buffer_t = i8[mut];
export type stream_t = stream[mut];

interface strlen(str: string_t): u64;
interface fputc(c: i32, stream: stream_t): i32;

export define print_string(push: (i32, [mut]) => void, context: [mut], str: string_t) {
    let beg = str;
    let end = str + strlen(str);

    foreach (c : beg..end)
        push(c, context);
}

export define print_string(push: (i32, [mut]) => void, context: [mut], str: string_t, from: u64, to: u64) {
    let beg = str + from;
    let end = str + to;

    foreach (c : beg..end)
        push(c, context);
}

export define print_int(push: (i32, [mut]) => void, context: [mut], mut value: u64, sign: u1, base: u8, upper: u1) {

    if (!value) {
        push('0', context);
        yield;
    }

    let mut buffer: i8[32];
    let mut index: u64 = 32;

    for (; value; value /= base) {
        let rem = value % base;
        let mut c: i8;
        if (rem < 10) {
            c = rem + '0';
        } else if (upper) {
            c = (rem - 10) + 'A';
        } else {
            c = (rem - 10) + 'a';
        }
        buffer[--index] = c;
    }

    if (sign) {
        buffer[--index] = '-';
    }

    print_string(push, context, buffer, index, 32);
}

#
# format: {type[:flags]}
#
# type:
#  - dN / iN: N-bit signed int dec
#  - uN: N-bit unsigned int dec
#  - oN: N-bit unsigned int oct
#  - xN: N-bit unsigned int hex lowercase
#  - XN: N-bit unsigned int hex uppercase
#  - fN: N-bit float dec
#  - p:  pointer
#  - s:  string
#  - c:  character
#  - b:  bool
#

const state_none = 0:u8;
const state_type = 1:u8;
const state_bits = 2:u8;
const state_flag = 3:u8;
const state_exit = 4:u8;

export define format(push: (i32, [mut]) => void, context: [mut], format: string_t, ...args) {
    let beg = format;
    let end = format + strlen(format);

    let mut state = state_none;

    let mut type: i8;
    let mut bits: u8;

    for (let mut i = beg; i != end; ) {
        switch (state) {
            [state_none] {
                let c = *(i++);
                if (c == '{') {
                    state = state_type;
                    break;
                }
                push(c, context);
            }
            [state_type] {
                switch (*i) {
                    ['d', 'i', 'u', 'o', 'x', 'X', 'f'] {
                        type = *(i++);
                        bits = 0;
                        state = state_bits;
                    }
                    ['p', 's', 'c', 'b'] {
                        type = *(i++);
                        if (*i == ':') {
                            i++;
                            state = state_flag;
                        } else {
                            state = state_exit;
                        }
                    }
                    [default] {
                        type = 0;
                        state = state_exit;
                    }
                }
            }
            [state_bits] {
                let c = *i;
                if (c == ':') {
                    i++;
                    state = state_flag;
                } else if ('0' <= c & c <= '9') {
                    bits = bits * 10 + (c - '0');
                    i++;
                } else {
                    state = state_exit;
                }
            }
            [state_flag] {
                # TODO: parse flags
                state = state_exit;
            }
            [state_exit] {
                if (type) {
                    i++; # skip trailing '{'
                }

                switch (type) {
                    ['d', 'i'] {
                        let arg = switch (bits) {
                            [1] -> args{i1};
                            [8] -> args{i8};
                            [16] -> args{i16};
                            [32] -> args{i32};
                            [64] -> args{i64};
                            [default] -> 0:i64;
                        };
                        let mut value: u64;
                        let mut sign: u1;
                        if (arg < 0) {
                            value = -arg;
                            sign = 1;
                        } else {
                            value = arg;
                            sign = 0;
                        }
                        print_int(push, context, value, sign, 10, 0);
                    }
                    ['u'] {
                        let arg = switch (bits) {
                            [1] -> args{u1};
                            [8] -> args{u8};
                            [16] -> args{u16};
                            [32] -> args{u32};
                            [64] -> args{u64};
                            [default] -> 0:u64;
                        };
                        print_int(push, context, arg, 0, 10, 0);
                    }
                    ['o'] {
                        let arg = switch (bits) {
                            [1] -> args{u1};
                            [8] -> args{u8};
                            [16] -> args{u16};
                            [32] -> args{u32};
                            [64] -> args{u64};
                            [default] -> 0:u64;
                        };
                        print_int(push, context, arg, 0, 8, 0);
                    }
                    ['x'] {
                        let arg = switch (bits) {
                            [1] -> args{u1};
                            [8] -> args{u8};
                            [16] -> args{u16};
                            [32] -> args{u32};
                            [64] -> args{u64};
                            [default] -> 0:u64;
                        };
                        print_int(push, context, arg, 0, 16, 0);
                    }
                    ['X'] {
                        let arg = switch (bits) {
                            [1] -> args{u1};
                            [8] -> args{u8};
                            [16] -> args{u16};
                            [32] -> args{u32};
                            [64] -> args{u64};
                            [default] -> 0:u64;
                        };
                        print_int(push, context, arg, 0, 16, 1);
                    }
                    ['f'] {
                        # TODO: print float dec
                        let arg = switch (bits) {
                            [16] -> args{f16};
                            [32] -> args{f32};
                            [64] -> args{f64};
                            [default] -> 0.0:f64;
                        };
                    }
                    ['p'] {
                        let arg = args{[]};
                        print_int(push, context, arg, 0, 16, 0);
                    }
                    ['s'] {
                        let arg = args{i8[]};
                        print_string(push, context, arg);
                    }
                    ['c'] {
                        let arg = args{i8};
                        push(arg, context);
                    }
                    ['b'] {
                        let arg = args{u1};
                        print_string(push, context, switch (arg) { [default, 0] -> "false"; [1] -> "true"; });
                    }
                    [0] {
                        push(*(i++), context);
                    }
                }
                state = state_none;
            }
        }
    }
}

type buffer_context_t = {
    buffer: buffer_t,
    count: u64,
    mut index: u64,
};

define push_buffer(c: i32, ptr: [mut]) {
    let mut &context = *(ptr as buffer_context_t[mut]);
    if (context.index < context.count)
        context.buffer[context.index++] = c;
}

export define format(buffer: buffer_t, count: u64, format: string_t, ...args) {
    let mut context: buffer_context_t = {
        buffer: buffer,
        count: count,
        index: 0,
    };
    format(push_buffer, &context, format, args);
}

define push_stream(c: i32, ptr: [mut]) {
    let stream = ptr as stream_t;
    fputc(c, stream);
}

export define format(stream: stream_t, format: string_t, ...args) {
    format(push_stream, stream, format, args);
}
