export define symbol1() {}
export define symbol2() {}
export define symbol3() {}
export define x() {}
export define y() {}
export define z() {}

export const TEST = "ABC";

export class MyClass {

    expose mut create(x: i32) {
        self.x = x;
    }

    expose mut delete() {
        self.x = 0;
    }

    expose get() {
        yield self.x;
    }

    expose mut set(x: i32) {
        self.x = x;
    }

    let mut x: i32;
}
