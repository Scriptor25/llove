interface putchar(chr: i32): i32;
interface puts(str: i8[]): i32;
interface strlen(str: i8[]): u64;

type iterable_struct_t = {
    begin: () => i8[],
    end:   () => i8[],
};

function begin_str(): i8[] {
    ret "Hello!\n";
}

function end_str(): i8[] {
    let str = begin_str();
    let len = strlen(str);
    ret str + len;
}

class iterable_class_t {
    public mut create() {
        self.str = "Hello!\n";
    }

    public begin(): i8[] {
        ret self.str;
    }

    public end(): i8[] {
        ret self.str + strlen(self.str);
    }

    let mut str: i8[];
}

interface main(count: i32, args: i8[][]): i32 {

    let my_range = args..(args + count);
    foreach (arg : my_range) {
        puts(arg);
    }

    let my_array = [0, 1, 2, 3, 4, 5]:i32;
    foreach (&x : my_array) {
        putchar(x + 0x30);
    }
    putchar('\n');

    let my_struct: iterable_struct_t = {
        begin: begin_str,
        end: end_str,
    };
    foreach (&x : my_struct) {
        putchar(x);
    }

    let my_class: iterable_class_t;
    foreach (&x : my_class) {
        putchar(x);
    }

    ret 0;
}
