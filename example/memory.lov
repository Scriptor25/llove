import { format } from "std/format.lov";

interface malloc(count: u64): [mut];
interface free(block: [mut]);

class test {

    public mut create() {
        format("test:create()\n");
        self.data_ptr = null;
        format("=> self={{ data_ptr: {rx0#:16} }\n", self.data_ptr);
    }

    public mut create(data: i32) {
        format("test:create(i32)\n");
        self.data_ptr = malloc(sizeof i32);
        *self.data_ptr = data;
        format("=> self={{ data_ptr: {rx0#:16} }\n", self.data_ptr);
    }

    public mut =(data: i32): mut &test {
        format("test{{ data_ptr: {rx0#:16} }:=(i32)\n", self.data_ptr);
        *self.data_ptr = data;
        ret self;
    }

    public mut create(mut other: test) {
        format("test:create(test)\n");
        self.data_ptr = other.data_ptr;
        other.data_ptr = null;
        format("=> self={{ data_ptr: {rx0#:16} }, other={{ data_ptr: {rx0#:16} }\n", self.data_ptr, other.data_ptr);
    }

    public mut =(mut other: test): mut &test {
        format("test{{ data_ptr: {rx0#:16} }:=(test)\n", self.data_ptr);
        let data_ptr = self.data_ptr;
        self.data_ptr = other.data_ptr;
        other.data_ptr = data_ptr;
        format("=> self={{ data_ptr: {rx0#:16} }, other={{ data_ptr: {rx0#:16} }\n", self.data_ptr, other.data_ptr);
        ret self;
    }

    public mut $(): test {
        let mut result: test;

        result.data_ptr = self.data_ptr;
        self.data_ptr = null;

        ret result;
    }

    public mut delete() {
        format("test{{ data_ptr: {rx0#:16} }:delete()\n", self.data_ptr);
        if (self.data_ptr) {
            free(self.data_ptr);
        }
        self.data_ptr = null;
    }

    public data(): i32 {
        ret *self.data_ptr;
    }

    public get(): i32[] {
        ret self.data_ptr;
    }

    let mut data_ptr: i32[mut];
}

template<T>
class unique {

    public mut create() {
        format("unique:create()\n");
        self.ptr = null;
    }

    public mut create(ptr: T[mut]) {
        format("unique:create(T[mut])\n");
        self.ptr = ptr;
    }

    public mut create(mut val: T) {
        format("unique:create(T)\n");
        self.ptr = malloc(sizeof T);
        create [*self.ptr] T($val);
    }

    public mut create(mut other: <T> unique) {
        format("unique:create(unique)\n");
        self.ptr = other.ptr;
        other.ptr = null;
    }

    public mut =(mut other: <T> unique): mut &<T> unique {
        format("unique{{ ptr: {rx0#:16} }:=(unique)\n", self.ptr as []);
        let ptr = self.ptr;
        self.ptr = other.ptr;
        other.ptr = ptr;
        ret self;
    }

    public mut $(): <T> unique {
        let mut result: <T> unique;

        result.ptr = self.ptr;
        self.ptr = null;

        ret self;
    }

    public mut delete() {
        format("unique{{ ptr: {rx0#:16} }:delete()\n", self.ptr as []);
        if (self.ptr) {
            delete *self.ptr;
            free(self.ptr);
        }
        self.ptr = null;
    }

    public *(): mut &T {
        ret *self.ptr;
    }

    public !(): u1 {
        ret !self.ptr;
    }

    public get(): T[mut] {
        ret self.ptr;
    }

    public cast(): u1 {
        ret self.ptr != null;
    }

    let mut ptr: T[mut];
}

interface main(): i32 {

    let u: <test> unique(create test(0));

    format("{} ({rx0#:16})\n", (*u).data(), (*u).get());

    *u = create test(123);

    format("{} ({rx0#:16})\n", (*u).data(), (*u).get());

    ret 0;
}
