import { format } from "std/format.lov";

interface malloc(count: u64): [mut];
interface free(block: [mut]);

class test {

    expose mut create() {
        format("test:create()\n");
        self.data_ptr = null;
        format("=> self={{ data_ptr: {rx0#:16} }\n", self.data_ptr);
    }

    expose mut create(data: i32) {
        format("test:create(i32)\n");
        self.data_ptr = malloc(sizeof i32);
        *self.data_ptr = data;
        format("=> self={{ data_ptr: {rx0#:16} }\n", self.data_ptr);
    }

    expose mut =(data: i32): mut &test {
        format("test{{ data_ptr: {rx0#:16} }:=(i32)\n", self.data_ptr);
        *self.data_ptr = data;
        yield self;
    }

    expose mut create(mut other: test) {
        format("test:create(test)\n");
        self.data_ptr = other.data_ptr;
        other.data_ptr = null;
        format("=> self={{ data_ptr: {rx0#:16} }, other={{ data_ptr: {rx0#:16} }\n", self.data_ptr, other.data_ptr);
    }

    expose mut =(mut other: test): mut &test {
        format("test{{ data_ptr: {rx0#:16} }:=(test)\n", self.data_ptr);
        let data_ptr = self.data_ptr;
        self.data_ptr = other.data_ptr;
        other.data_ptr = data_ptr;
        format("=> self={{ data_ptr: {rx0#:16} }, other={{ data_ptr: {rx0#:16} }\n", self.data_ptr, other.data_ptr);
        yield self;
    }

    expose mut $(): test {
        let mut result: test;

        result.data_ptr = self.data_ptr;
        self.data_ptr = null;

        yield result;
    }

    expose mut delete() {
        format("test{{ data_ptr: {rx0#:16} }:delete()\n", self.data_ptr);
        if (self.data_ptr) {
            free(self.data_ptr);
        }
        self.data_ptr = null;
    }

    expose data(): i32 {
        yield *self.data_ptr;
    }

    expose get(): i32[] {
        yield self.data_ptr;
    }

    let mut data_ptr: i32[mut];
}

class unique<T> {

    expose mut create() {
        format("unique:create()\n");
        self.ptr = null;
    }

    expose mut create(ptr: T[mut]) {
        format("unique:create(T[mut])\n");
        self.ptr = ptr;
    }

    expose mut create(mut val: T) {
        format("unique:create(T)\n");
        self.ptr = malloc(sizeof T);
        create[*self.ptr] T($val);
    }

    expose mut create(mut other: class<T> unique) {
        format("unique:create(unique)\n");
        self.ptr = other.ptr;
        other.ptr = null;
    }

    expose mut =(mut other: class<T> unique): mut &class<T> unique {
        format("unique{{ ptr: {rx0#:16} }:=(unique)\n", self.ptr as []);
        let ptr = self.ptr;
        self.ptr = other.ptr;
        other.ptr = ptr;
        yield self;
    }

    expose mut $(): class<T> unique {
        let mut result: class<T> unique;

        result.ptr = self.ptr;
        self.ptr = null;

        yield self;
    }

    expose mut delete() {
        format("unique{{ ptr: {rx0#:16} }:delete()\n", self.ptr as []);
        if (self.ptr) {
            delete *self.ptr;
            free(self.ptr);
        }
        self.ptr = null;
    }

    expose *(): mut &T {
        yield *self.ptr;
    }

    expose !(): u1 {
        yield !self.ptr;
    }

    expose get(): T[mut] {
        yield self.ptr;
    }

    expose cast(): u1 {
        yield self.ptr != null;
    }

    let mut ptr: T[mut];
}

interface main(): i32 {

    let u: class<test> unique(create test(0));

    format("{} ({rx0#:16})\n", (*u).data(), (*u).get());

    *u = create test(123);

    format("{} ({rx0#:16})\n", (*u).data(), (*u).get());

    yield 0;
}
