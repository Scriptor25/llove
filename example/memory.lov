interface printf(format: i8[], ...): i32;
interface malloc(count: u64): [mut];
interface free(block: [mut]);

class test {

    # create
    expose mut create() {
        printf("test:create()\r\n");
        self.data_ptr = null;
        printf("=> self={ data_ptr: %p }\r\n", self.data_ptr);
    }

    expose mut create(data: i32) {
        printf("test:create(i32)\r\n");
        self.data_ptr = malloc(sizeof i32);
        *self.data_ptr = data;
        printf("=> self={ data_ptr: %p }\r\n", self.data_ptr);
    }

    expose mut =(data: i32): mut &test {
        printf("test{ data_ptr: %p }:=(i32)\r\n", self.data_ptr);
        *self.data_ptr = data;
        yield self;
    }

    # move
    expose mut create(mut other: test) {
        printf("test:create(test)\r\n");
        self.data_ptr = other.data_ptr;
        other.data_ptr = null;
        printf("=> self={ data_ptr: %p }, other={ data_ptr: %p }\r\n", self.data_ptr, other.data_ptr);
    }

    expose mut =(mut other: test): mut &test {
        printf("test{ data_ptr: %p }:=(test)\r\n", self.data_ptr);
        let data_ptr = self.data_ptr;
        self.data_ptr = other.data_ptr;
        other.data_ptr = data_ptr;
        printf("=> self={ data_ptr: %p }, other={ data_ptr: %p }\r\n", self.data_ptr, other.data_ptr);
        yield self;
    }

    # copy
    # expose mut create(&other: test) {
    #     printf("test:create(&test)\r\n");
    #     self.data_ptr = malloc(sizeof i32);
    #     *self.data_ptr = *other.data_ptr;
    #     printf("=> self={ data_ptr: %p }, other={ data_ptr: %p }\r\n", self.data_ptr, other.data_ptr);
    # }

    # expose mut =(&other: test): mut &test {
    #     printf("test{ data_ptr: %p }:=(&test)\r\n", self.data_ptr);
    #     *self.data_ptr = *other.data_ptr;
    #     printf("=> self={ data_ptr: %p }, other={ data_ptr: %p }\r\n", self.data_ptr, other.data_ptr);
    #     yield self;
    # }

    expose mut $(): test {
        let mut result: test;

        result.data_ptr = self.data_ptr;
        self.data_ptr = null;

        yield result;
    }

    # delete
    expose mut delete() {
        printf("test{ data_ptr: %p }:delete()\r\n", self.data_ptr);
        if (self.data_ptr) {
            free(self.data_ptr);
        }
        self.data_ptr = null;
    }

    # getter
    expose data(): i32 {
        yield *self.data_ptr;
    }

    expose get(): i32[] {
        yield self.data_ptr;
    }

    let mut data_ptr: i32[mut];
}

class<T> unique {

    expose mut create() {
        printf("unique:create()\r\n");
        self.ptr = null;
    }

    expose mut create(ptr: T[mut]) {
        printf("unique:create(T[mut])\r\n");
        self.ptr = ptr;
    }

    expose mut create(mut val: T) {
        printf("unique:create(T)\r\n");
        self.ptr = malloc(sizeof T);
        create[*self.ptr] T($val);
    }

    # expose mut create(&val: T) {
    #     printf("unique:create(T)\r\n");
    #     self.ptr = malloc(sizeof T);
    #     create[*self.ptr] T(val);
    # }

    expose mut create(mut other: class<T> unique) {
        printf("unique:create(unique)\r\n");
        self.ptr = other.ptr;
        other.ptr = null;
    }

    expose implicit mut create(&other: class<T> unique) @delete;

    expose mut =(mut other: class<T> unique): mut &class<T> unique {
        printf("unique{ ptr: %p }:=(unique)\r\n", self.ptr);
        let ptr = self.ptr;
        self.ptr = other.ptr;
        other.ptr = ptr;
        yield self;
    }

    expose mut =(&other: class<T> unique): mut &class<T> unique @delete;

    expose mut $(): class<T> unique {
        let mut result: class<T> unique;

        result.ptr = self.ptr;
        self.ptr = null;

        yield self;
    }

    expose mut delete() {
        printf("unique{ ptr: %p }:delete()\r\n", self.ptr);
        if (self.ptr) {
            delete *self.ptr;
            free(self.ptr);
        }
        self.ptr = null;
    }

    expose *(): mut &T {
        yield *self.ptr;
    }

    expose !(): u1 {
        yield !self.ptr;
    }

    expose get(): T[mut] {
        yield self.ptr;
    }

    expose cast(): u1 {
        yield self.ptr != null;
    }

    let mut ptr: T[mut];
}

interface main(): i32 {

    let u: class<test> unique(create test(0));

    printf("%d (%p)\r\n", (*u).data(), (*u).get());

    *u = create test(123);

    printf("%d (%p)\r\n", (*u).data(), (*u).get());

    yield 0;
}
