import { string_t, stream_t, format } from "format.lov";

interface fopen(filename: string_t, mode: string_t): stream_t;
interface fclose(stream: stream_t): i32;

class Stream {

    expose mut create(filename: string_t, mode: string_t) {
        self.stream = fopen(filename, mode);
    }

    expose mut delete() {
        if (self.stream)
            fclose(self.stream);
        self.stream = null;
    }

    expose format(format: string_t, ...args) {
        format(self.stream, format, args);
    }

    let mut stream: stream_t;
}

interface main(): i32 {

    let stream: Stream("out.ppm", "wb");

    let width: u32 = 200;
    let height: u32 = 100;

    stream.format("P6 {u32} {u32} 255 ", width, height);

    foreach (j : (0)..height)
    foreach (i : (0)..width) {
        let r: f64 = i / (width  - 1.0);
        let g: f64 = j / (height - 1.0);
        let b: f64 = 0.2;

        let ir: u8 = ((r * 255.999) as u32) & 0xff;
        let ig: u8 = ((g * 255.999) as u32) & 0xff;
        let ib: u8 = ((b * 255.999) as u32) & 0xff;

        stream.format("{c}{c}{c}", ir, ig, ib);
    }

    yield 0;
}
