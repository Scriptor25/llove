export const typeid_void: u32     = 'v';
export const typeid_variadic: u32 = 'z';
export const typeid_integer: u32  = 'i';
export const typeid_float: u32    = 'f';
export const typeid_pointer: u32  = 'p';
export const typeid_array: u32    = 'a';
export const typeid_struct: u32   = 's';
export const typeid_tuple: u32    = 'm';
export const typeid_range: u32    = 'r';
export const typeid_class: u32    = 'c';
export const typeid_function: u32 = 'x';
export const typeid_template: u32 = 't';

interface malloc(count: u64): [mut];
interface free(block: []);

define new<T>(mut val: T): T[mut] {
    let p: T[mut] = malloc(sizeof T);
    *p = $val;
    ret p;
}

export class type {

    expose mut create(id: u32);

    expose virtual mut delete();
    expose virtual mut $(): type;

    expose id(): u32;

    let id: u32;
}

export type type_ptr = type[mut];

export class void_type : type {

    expose mut create() [ create(typeid_void) ] {
    }

    expose override mut $(): void_type {
        ret self;
    }
}

export class variadic_type : type {

    expose mut create() [ create(typeid_variadic) ] {
    }

    expose override mut $(): variadic_type {
        ret self;
    }
}

export class integer_type : type {

    expose mut create(is_signed: u1, bits: u32) [
        create(typeid_integer),
        is_signed,
        bits,
    ] {
    }

    expose override mut $(): integer_type {
        ret self;
    }

    expose is_signed(): u1 {
        ret self.is_signed;
    }

    expose bits(): u32 {
        ret self.bits;
    }

    let is_signed: u1;
    let bits: u32;
}

export class float_type : type {

    expose mut create(bits: u32) [
        create(typeid_float),
        bits,
    ] {
    }

    expose override mut $(): float_type {
        ret self;
    }

    expose bits(): u32 {
        ret self.bits;
    }

    let bits: u32;
}

export class pointer_type : type {

    expose mut create(is_mutable: u1, is_opaque: u1, base: type_ptr) [
        create(typeid_pointer),
        is_mutable,
        is_opaque,
        base,
    ] {
    }

    expose override mut delete() {
        if (self.base) {
            free(self.base);
            self.base = null;
        }
    }

    expose override mut $(): pointer_type {
        let mut t: pointer_type(self.is_mutable, self.is_opaque, self.base);
        self.base = null;
        ret t;
    }

    expose is_mutable(): u1 {
        ret self.is_mutable;
    }

    expose is_opaque(): u1 {
        ret self.is_opaque;
    }

    expose base(): type_ptr {
        ret self.base;
    }

    let is_mutable: u1;
    let is_opaque: u1;
    let mut base: type_ptr;
}

export class array_type : type {

    expose mut create(count: u32, base: type_ptr) [
        create(typeid_array),
        count,
        base,
    ] {
    }

    expose override mut delete() {
        if (self.base) {
            free(self.base);
            self.base = null;
        }
    }

    expose override mut $(): array_type {
        let mut t: array_type(self.count, self.base);
        self.base = null;
        ret t;
    }

    expose count(): u32 {
        ret self.count;
    }

    expose base(): type_ptr {
        ret self.base;
    }

    let count: u32;
    let mut base: type_ptr;
}

export class struct_type : type {

    expose mut create(count: u32, fields: type_ptr[mut]) [
        create(typeid_struct),
        count,
        fields,
    ] {
    }

    expose override mut delete() {
        if (self.fields) {
            foreach (field : self) {
                free(field);
            }

            free(self.fields);

            self.count = 0;
            self.fields = null;
        }
    }

    expose override mut $(): struct_type {
        let mut t: struct_type(self.count, self.fields);
        self.count = 0;
        self.fields = null;
        ret t;
    }

    expose mut begin(): type_ptr[mut] {
        ret self.fields;
    }

    expose mut end(): type_ptr[mut] {
        ret self.fields + self.count;
    }

    expose begin(): type_ptr[] {
        ret self.fields;
    }

    expose end(): type_ptr[] {
        ret self.fields + self.count;
    }

    let mut count: u32;
    let mut fields: type_ptr[mut];
}

export class range_type : type {

    expose mut create(entry: type_ptr) [
        create(typeid_range),
        entry,
    ] {
    }

    expose override mut delete() {
        if (self.entry) {
            free(self.entry);
            self.entry = null;
        }
    }

    expose override mut $(): range_type {
        let mut t: range_type(self.entry);
        self.entry = null;
        ret t;
    }

    expose entry(): type_ptr {
        ret self.entry;
    }

    let mut entry: type_ptr;
}

export define parse(mut typeinfo: u8[]): type_ptr {

    let id = *(typeinfo as u32[]);
    typeinfo += sizeof u32;

    switch (id) {
        [typeid_void] {
            ret <void_type> new(create void_type);
        }
        [typeid_variadic] {
            ret <variadic_type> new(create variadic_type);
        }
        [typeid_integer] {
            let is_signed = *(typeinfo as u1[]);
            typeinfo += sizeof u1;
            let bits = *(typeinfo as u32[]);
            typeinfo += sizeof u32;

            ret <integer_type> new(create integer_type(is_signed, bits));
        }
        [typeid_float] {
            let bits = *(typeinfo as u32[]);
            typeinfo += sizeof u32;

            ret <float_type> new(create float_type(bits));
        }
        [typeid_pointer] {
            let is_mutable = *(typeinfo as u1[]);
            typeinfo += sizeof u1;
            let is_opaque = *(typeinfo as u1[]);
            typeinfo += sizeof u1;

            let base = is_opaque ? null:mut:type : parse(typeinfo);

            ret <pointer_type> new(create pointer_type(is_mutable, is_opaque, base));
        }
        [typeid_array] {
            let count = *(typeinfo as u32[]);
            typeinfo += sizeof u32;
            let base = parse(typeinfo);

            ret <array_type> new(create array_type(count, base));
        }
        [typeid_struct] {
            let count = *(typeinfo as u32[]);
            typeinfo += sizeof u32;

            let fields: type_ptr[mut] = malloc(count * sizeof type_ptr);
            for (let mut i: u32; i < count; ++i)
                fields[i] = parse(typeinfo);

            ret <struct_type> new(create struct_type(count, fields));
        }
        [typeid_range] {
            let entry = parse(typeinfo);

            ret <range_type> new(create range_type(entry));
        }
        [default] {
            ret null:mut:type;
        }
    }
}

define:type mut create(id: u32) [ id ] {
}

define:type mut delete() {
    switch (self.id) {
        [typeid_pointer] {
            ((&self) as pointer_type[mut])::delete();
        }
        [typeid_array] {
            ((&self) as array_type[mut])::delete();
        }
        [typeid_struct] {
            ((&self) as struct_type[mut])::delete();
        }
        [typeid_range] {
            ((&self) as range_type[mut])::delete();
        }
    }
}

define:type mut $(): type {
    switch (self.id) {
        [typeid_void] {
            ret $*((&self) as void_type[mut]);
        }
        [typeid_variadic] {
            ret $*((&self) as variadic_type[mut]);
        }
        [typeid_integer] {
            ret $*((&self) as integer_type[mut]);
        }
        [typeid_float] {
            ret $*((&self) as float_type[mut]);
        }
        [typeid_pointer] {
            ret $*((&self) as pointer_type[mut]);
        }
        [typeid_array] {
            ret $*((&self) as array_type[mut]);
        }
        [typeid_struct] {
            ret $*((&self) as struct_type[mut]);
        }
        [typeid_range] {
            ret $*((&self) as range_type[mut]);
        }
        [default] {
            ret self;
        }
    }
}

define:type id(): u32 {
    ret self.id;
}
