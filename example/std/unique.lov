export interface malloc(count: u64): [mut];
export interface free(block: [mut]);

export template<T>
class unique {

    public mut create() {
        self.ptr = null;
    }

    public mut create(ptr: T[mut]) {
        self.ptr = ptr;
    }

    public mut create(mut val: T) {
        self.ptr = malloc(sizeof T);
        *self.ptr = $val;
    }

    public mut create(&val: T) {
        self.ptr = malloc(sizeof T);
        *self.ptr = val;
    }

    public mut delete() {
        if (self.ptr) {
            delete *self.ptr;
            free(self.ptr);
            self.ptr = null;
        }
    }

    public mut $(): <T> unique {
        let mut u: <T> unique(self.ptr);
        self.ptr = null;
        ret u;
    }

    public cast(): u1 {
        ret self.ptr != null;
    }

    public !(): u1 {
        ret self.ptr == null;
    }

    public *(): mut &T {
        ret *self.ptr;
    }

    public get(): T[mut] {
        ret self.ptr;
    }

    public mut release(): T[mut] {
        let ptr = self.ptr;
        self.ptr = null;
        ret ptr;
    }

    let mut ptr: T[mut];
}

export template<T, U>
function implicit cast(mut t: <T> unique): <U> unique {
    ret create <U> unique(t.release() as U[mut]);
}

export template<T>
function make_unique(mut val: T): <T> unique {
    let p: T[mut] = malloc(sizeof T);
    *p = $val;
    ret create <T> unique(p);
}
